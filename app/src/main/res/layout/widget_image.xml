<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="fitXY" />
    <!-- zone trasparenti per i tocchi: la loro altezza arriva da un'immagine trasparente -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <ImageView android:id="@+id/zone_main" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/zone_hours" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/zone_rain" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/zone_days" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no" />
    </LinearLayout>
    <ImageView
        android:id="@+id/widget_alert"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="42dp"
        android:padding="5dp"
        android:contentDescription="Allerta meteo"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/widget_alert2"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:padding="4dp"
        android:contentDescription="Allerta meteo"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/widget_refresh"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:padding="10dp"
        android:contentDescription="Aggiorna"
        android:src="@drawable/ic_refresh" />
</FrameLayout>
